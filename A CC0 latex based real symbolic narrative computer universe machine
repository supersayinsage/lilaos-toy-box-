        if state.location is None:

            if "duck" in state.seed.lower() or "pond" in state.seed.lower():

                state.location = "a quiet pond in an ancient park"

            elif "star" in state.seed.lower() or "universe" in state.seed.lower():

                state.location = "the edge of a spiral galaxy"

            elif "mountain" in state.seed.lower() or "valley" in state.seed.lower():

                state.location = "a hidden valley between two peaks"

            else:

                state.location = "a quiet valley"

            

            text += f"The story unfolds in {state.location}.\n\n"

            state.events.append("location set")

            state.phase = "SETTLING"

        

        # Rule 3: Character introduction

        if len(state.characters) == 0:

            if "duck" in state.seed.lower():

                state.characters = ["Duck A", "Duck B"]

                text += "Two figures emerged from the stillness: Duck A and Duck B.\n"

                text += "One traced patterns in the water. The other watched the sky.\n\n"

            elif "star" in state.seed.lower():

                state.characters = ["Sirius", "Vega"]

                text += "Two stars in the constellation: Sirius and Vega.\n"

                text += "Their light traveled across the void to meet.\n\n"

            else:

                state.characters = ["The Seeker", "The Guide"]

                text += "Two figures appeared: The Seeker and The Guide.\n"

                text += "One asked questions. The other held the answers.\n\n"

            state.events.append("characters introduced")

            state.phase = "ENCOUNTER"

        

        # Rule 4: Dialogue or interaction

        if "Duck" in str(state.characters):

            text += "Duck A spoke first: \\textit{``The water remembers everything.''}\n"

            text += "Duck B tilted its head: \\textit{``Then why does it keep changing?''}\n\n"

            text += "Duck A said: \\textit{``We are shadows on the water.''}\n"

            text += "Duck B replied: \\textit{``No -- the water is a shadow of us.''}\n\n"

        elif "Sirius" in str(state.characters):

            text += "Sirius pulsed: \\textit{``Light is the only truth we know.''}\n"

            text += "Vega flickered: \\textit{``And yet, darkness is what gives it shape.''}\n\n"

        else:

            text += "The Seeker asked: \\textit{``What lies beyond this moment?''}\n"

            text += "The Guide answered: \\textit{``Everything and nothing, in equal measure.''}\n\n"

        

        state.events.append("dialogue occurred")

        state.phase = "REFLECTION"

        

        # Rule 5: Lesson or wisdom

        text += "A leaf fell, touching the surface with a soft voice.\n"

        text += "The ripples spread outward in perfect circles.\n"

        text += "\\textit{``That,''} said one, \\textit{``is a story.''}\n"

        text += "\\textit{``Every story is a ripple,''} said the other.\n"

        text += "\\textit{``It begins somewhere, spreads everywhere, and never truly ends.''}\n\n"

        state.events.append("wisdom shared")

        state.phase = "WISDOM"

        

        # Rule 6: Chapter ending

        text += f"Chapter {state.chapter} ends.\n"

        text += "The story continues, as all stories do.\n"

        state.events.append("chapter ended")

        state.phase = "RESTING"

        

        # Count words

        state.word_count += len(text.split())

        

        # Update chapter

        state.chapter += 1

        

        return text, state

    

    def generate_chapter(self) -> str:

        """Generate one chapter deterministically."""

        if self.state is None:

            raise ValueError("State not initialized. Call initialize_state() first.")

        

        chapter_text, self.state = self.deterministic_rules(self.state)

        self.output.append(chapter_text)

        self.total_words += self.state.word_count

        return chapter_text

    

    def generate_story(self, num_chapters: int = 3) -> str:

        """Generate a complete story with the specified number of chapters."""

        if self.state is None:

            raise ValueError("State not initialized. Call initialize_state() first.")

        

        self.output = []

        for  in range(numchapters):

            self.generate_chapter()

        

        return "\n\n".join(self.output)

    

    def save_output(self, filename: str = "story_output.tex") -> None:

        """Save the generated story to a file."""

        output_path = Path(filename)

        output_text = self._format_output()

        output_path.write_text(output_text, encoding="utf-8")

        print(f"Story generated deterministically -> {output_path}")

    

    def formatoutput(self) -> str:

        """Format the output as a complete document."""

        if not self.output:

            return ""

        

        # Build HSON wrapper

        hson_output = f"""

HSON_STORY_OUTPUT {{

  meta {{

    version    = 1.0

    runtime    = SYMBOLIC_OS

    entrypoint = RUN_MACHINE

    engine     = MACHINE_APPLIED_SEED

    type       = DETERMINISTIC

    generator  = MachineB

  }}

  input {{

    narrative_seed = "{self.state.seed if self.state else 'unknown'}"

    machine_source = "{self.machine_a.machine_source}"

  }}

  output {{

    format  = LATEX

    words   = {self.total_words}

  }}

  chapter_1 {{

    {self.output[0] if self.output else 'No content'}

  }}

  scene RUN_MACHINE {{

    id   = CHAPTER_1

    text = STORY_ENGINE.RUN

  }}

}}

"""

        return hson_output

    

    def display_status(self) -> str:

        """Display the current status of Machine B."""

        if not self.state:

            return "Machine B: Not initialized"

        

        return f"""

=============================================================================

MACHINE B: GENERATION STATUS

=============================================================================

Seed:        {self.state.seed}

Chapter:     {self.state.chapter}

Location:    {self.state.location}

Phase:       {self.state.phase}

Characters:  {', '.join(self.state.characters) if self.state.characters else 'None'}

Events:      {len(self.state.events)}

Word Count:  {self.state.word_count}

Total Words: {self.total_words}

=============================================================================

"""

